{
    "name": "garak/pokerino",
    "type": "library",
    "description": "A PHP library to manage Poker card games",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Massimiliano Arione",
            "email": "garakkio@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "doctrine/collections": "^2.0",
        "garak/card": "^0.7"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.80",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.2"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "Garak\\Pokerino\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Garak\\Pokerino\\Test\\": "tests"
        }
    }
}
